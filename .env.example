# Configuration for the self-hosted GitHub App mode (docker compose: gateway, worker, engine).
# GitHub Action mode does not use this file: configure it with `with:` inputs in the workflow
# and a CURSOR_API_KEY repository secret (see examples/ai-review.yml).
# Copy to .env and fill in the blanks.

# --- GitHub App (App mode only) ---------------------------------------------------------
GITHUB_APP_ID=
# Private key downloaded from the App settings page; docker compose mounts ./secrets read-only.
GITHUB_PRIVATE_KEY_PATH=./secrets/github-app.pem
# Same value as "Webhook secret" in the App settings.
GITHUB_WEBHOOK_SECRET=
# Change for GitHub Enterprise Server, e.g. https://ghe.example.com/api/v3
GITHUB_API_URL=https://api.github.com

# --- Infrastructure (App mode only) -----------------------------------------------------
REDIS_URL=redis://localhost:6379/0
ENGINE_URL=http://localhost:8090
GATEWAY_ADDR=:8080
ENGINE_PORT=8090
WORKER_CONCURRENCY=4

# --- LLM provider -----------------------------------------------------------------------
# "cursor" uses your Cursor API key (Cursor Dashboard -> Integrations); usage counts against
# your Cursor plan. "gemini" uses a Google AI Studio key.
LLM_PROVIDER=cursor
CURSOR_API_KEY=
GEMINI_API_KEY=
# Empty means the provider default: composer-2.5 (cursor) or gemini-3.6-flash (gemini).
LLM_MODEL=
# Parallel model calls; keep low on a Pro plan.
ENGINE_CONCURRENCY=2
ENGINE_MAX_RETRIES=3
ENGINE_MAX_OUTPUT_TOKENS=8192

# --- Review limits ----------------------------------------------------------------------
MAX_FILES=50
MAX_COMMENTS=15
MIN_CONFIDENCE=0.6
# low | medium | high | critical
MIN_SEVERITY=low
CHUNK_TOKEN_BUDGET=12000
# Approximate prompt tokens per PR review; bounds plan usage.
MAX_TOTAL_TOKENS=60000
MAX_PATCH_LINES=1500
CONTEXT_LINES=40

# --- Optional features ------------------------------------------------------------------
# Second model pass that double-checks high and critical findings.
VERIFY_FINDINGS=true
# Post an "AI code review" Check Run; requires the App's Checks: read & write permission.
ENABLE_CHECK_RUN=false
